GHL_AGENCY_TOKEN=
# Optional for GET /locations/search; use if your agency token requires an explicit company filter.
GHL_COMPANY_ID=
# Optional. Defaults to ./logs.
GHL_CONNECTIVITY_LOG_DIR=logs

# Reserved for a later OAuth-based Custom Values phase. Not used by the
# read-only agency connectivity test.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=
GHL_REFRESH_TOKEN=
GHL_APP_ID=
# Optional. Defaults to .ghl_tokens.json; keep this file private and out of git.
GHL_TOKEN_STORE=.ghl_tokens.json

# Vimeo Personal Access Token. Used only by the GET-only connectivity test.
VIMEO_ACCESS_TOKEN=
# Optional comma-separated Vimeo user IDs of known Team Library owners. Vimeo
# sometimes advertises a teams connection but returns 404 when it is followed.
VIMEO_TEAM_OWNER_USER_IDS=
# Optional. Defaults to ./logs.
VIMEO_CONNECTIVITY_LOG_DIR=logs

# WebPrez Playwright proof of concept. The storage-state file contains an
# authenticated browser session and must remain private (0600 and gitignored).
WEBPREZ_BASE_URL=https://app.webprez.com
WEBPREZ_STORAGE_STATE=playwright/.auth/webprez.json
